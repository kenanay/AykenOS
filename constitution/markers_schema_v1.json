          "pattern": "\\[\\[AYKEN_GATE4_PID\\]\\] pid=[0-9]+",
          "required_count": 1
        },
        "ring3_publish": {
          "pattern": "\\[\\[AYKEN_RING3_PUBLISH\\]\\] pid=[0-9]+ epoch=[0-9]+",
          "required_count": 1
        },
        "mailbox_accept": {
          "pattern": "\\[\\[AYKEN_SCHED_MB_ACCEPT\\]\\] pid=[0-9]+ epoch=[0-9]+",
          "required_count": 1
        },
        "proof_done": {
          "pattern": "\\[\\[AYKEN_PROOF_DONE\\]\\]",
          "required_count": 0
        }
      },
      "ordering": [
        ["ring3_publish", "mailbox_accept"]
      ]
    },
    "gate45_decision_switch": {
      "description": "Gate-4.5 decision->switch runtime marker schema baseline.",
      "profile_flags": {
        "requires_multi_owner": true
      },
      "markers": {
        "ring3_publish": {
          "pattern": "\\[\\[AYKEN_RING3_PUBLISH\\]\\] pid=[0-9]+ epoch=[0-9]+",
          "required_count": 1
        },
        "mailbox_accept": {
          "pattern": "\\[\\[AYKEN_SCHED_MB_ACCEPT\\]\\] pid=[0-9]+ epoch=[0-9]+",
          "required_count": 1
        },
        "arbiter_decision": {
          "pattern": "\\[\\[AYKEN_SCHED_ARBITER_DECISION\\]\\] from=[0-9]+ to=[0-9]+ epoch=[0-9]+",
          "required_count": 1
        },
        "ctx_switch": {
          "pattern": "\\[\\[AYKEN_CTX_SWITCH\\]\\] from=[0-9]+ to=[0-9]+",
          "required_count": 1
        },
        "proof_done": {
          "pattern": "\\[\\[AYKEN_PROOF_DONE\\]\\]",
          "required_count": 1
        }
      },
      "ordering": [
        ["ring3_publish", "mailbox_accept"],
        ["mailbox_accept", "arbiter_decision"],
        ["arbiter_decision", "ctx_switch"]
      ]
    }
