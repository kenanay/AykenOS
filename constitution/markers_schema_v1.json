        "P10_RFLAGS_IF_OFF": {
          "token": "P10_RFLAGS_IF_OFF",
          "required_count": 0
        },
        "P10_CR3_SWITCH": {
          "token": "P10_CR3_SWITCH",
          "required_count": 1
        },
        "P10_RING3_ENTER": {
          "token": "P10_RING3_ENTER",
          "required_count": 1
        },
        "AYKEN_SYSCALL_ENTER": {
          "token": "[[AYKEN_SYSCALL_ENTER]]",
          "required_count": 1
