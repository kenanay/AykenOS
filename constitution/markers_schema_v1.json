        ["P10_CAP_ENFORCED", "P10_RING3_USER_CODE"]
      ]
    },
    "gate45_proof": {
      "description": "Gate-4.5 decision->switch proof marker schema baseline.",
      "markers": {
        "ring3_publish": {
          "pattern": "\\[\\[AYKEN_RING3_PUBLISH\\]\\] pid=[0-9]+ epoch=[0-9]+",
          "required_count": 1
        },
        "mailbox_accept": {
          "pattern": "\\[\\[AYKEN_SCHED_MB_ACCEPT\\]\\] pid=[0-9]+ epoch=[0-9]+",
          "required_count": 1
        },
        "arbiter_decision": {
          "pattern": "\\[\\[AYKEN_SCHED_ARBITER_DECISION\\]\\]",
          "required_count": 1
        },
        "ctx_switch": {
          "pattern": "\\[\\[AYKEN_CTX_SWITCH\\]\\]",
          "required_count": 1
        },
        "proof_done": {
          "pattern": "\\[\\[AYKEN_PROOF_DONE\\]\\]",
          "required_count": 1
        }
      },
      "ordering": [
        ["ring3_publish", "mailbox_accept"],
        ["mailbox_accept", "arbiter_decision"],
        ["arbiter_decision", "ctx_switch"]
      ]
    },
    "gate4_policy_accept": {
      "description": "Gate-4 policy-accept proof marker schema baseline.",
      "markers": {
