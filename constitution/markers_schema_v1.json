        "P10_SYSCALL_ENTER": {
          "token": "P10_SYSCALL_ENTER",
          "required_count": 1
        },
        "AYKEN_SYSCALL_RETURN": {
          "token": "[[AYKEN_SYSCALL_RETURN]]",
          "required_count": 1
        },
        "P10_SYSCALL_RETURN": {
          "token": "P10_SYSCALL_RETURN",
          "required_count": 1
