        "P10_CAP_ENFORCED": {
          "token": "P10_CAP_ENFORCED",
          "required_count": 1
        },
        "P10_RING3_USER_CODE": {
          "token": "P10_RING3_USER_CODE",
          "required_count": 1
        }
      },
      "ordering": [
        ["P10_TSS_OK", "KERNEL_BEFORE_RING3"],
        ["KERNEL_BEFORE_RING3", "AYKEN_RING3_PREP_OK"],
        ["AYKEN_RING3_PREP_OK", "P10_SCHED_DISPATCH"],
        ["P10_SCHED_DISPATCH", "P10_RFLAGS_IF_ON"],
