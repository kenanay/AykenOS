	@$(MAKE) KERNEL_PROFILE=validation VALIDATION_WERROR=1 all


# ------------------------------------------------------------
# 4) Kernel build
# ------------------------------------------------------------

$(PROFILE_STAMP): FORCE
	@mkdir -p $(dir $@)
	@if [ ! -f $(PROFILE_STAMP) ] || [ "$$(cat $(PROFILE_STAMP) 2>/dev/null)" != "$(KERNEL_PROFILE)" ]; then \
		echo "$(KERNEL_PROFILE)" > $(PROFILE_STAMP); \
	fi

$(KERNEL_OBJS): $(PROFILE_STAMP) $(EMBEDDED_ELF_HEADER) $(PAYLOAD_MANIFEST)

$(KERNEL_ELF): $(KERNEL_OBJS) linker.ld $(PROFILE_STAMP) $(KERNEL_LINK_EXTRA_DEPS) $(PAYLOAD_MANIFEST)
	@mkdir -p $(dir $@)
	@if [ ! -f "$(PAYLOAD_MANIFEST)" ]; then \
		echo "[ERROR] Payload manifest missing: $(PAYLOAD_MANIFEST)"; \
		echo "[ERROR] Kernel build cannot complete without manifest (AUTHORITY)"; \
		exit 1; \
	fi
	$(KERNEL_LD) -T linker.ld $(KERNEL_LDFLAGS) $(KERNEL_LINK_EXTRA_FLAGS) $(if $(strip $(KERNEL_MAP)),-Map=$(KERNEL_MAP),) -o $@ $(KERNEL_OBJS)

kernel.elf: $(KERNEL_ELF)
	cp -f "$<" "$@"

# Generate NASM ABI include from single C ABI source.
.PHONY: generate-abi
generate-abi: $(ABI_INC)
	@echo "ABI include generated: $(ABI_INC)"

$(ABI_INC): $(ABI_H)
	@mkdir -p $(dir $@)
	@echo "; AUTO-GENERATED. DO NOT EDIT." > $@
	@echo "; Source: $(ABI_H)" >> $@
	@awk '\
		$$1 == "#define" && $$2 == "AYKEN_ABI_VERSION" { \
			val = $$3; gsub(/[uU]/, "", val); \
			printf("%%define AYKEN_ABI_VERSION %s\n", val); \
			next; \
		} \
		$$1 == "#define" && $$2 ~ /^(CTX_|IRQF_)/ { \
			val = $$3; gsub(/[uU]/, "", val); \
			printf("%%define %s %s\n", $$2, val); \
		}' $(ABI_H) >> $@

$(RING0_EXPORT_MAP): $(KERNEL_OBJS) $(RING0_SYMBOL_WHITELIST) scripts/ci/generate_ring0_export_map.py
	@mkdir -p $(dir $@)
	@python3 scripts/ci/generate_ring0_export_map.py \
		--whitelist "$(RING0_SYMBOL_WHITELIST)" \
		--output "$@" \
		--nm "nm" \
		--objects $(KERNEL_OBJS)

$(KERNEL_ASM_SOURCES:.asm=.o): $(ABI_INC)

# C -> .o
kernel/arch/x86_64/gdt_idt.o: KERNEL_CFLAGS := $(KERNEL_CFLAGS_GDT)
%.o: %.c
	$(KERNEL_CC) $(KERNEL_CFLAGS) -c $< -o $@

# asm -> .o (kernel/arch/x86_64/*.asm)
%.o: %.asm
	nasm -f elf64 $(KERNEL_ASMFLAGS) $< -o $@

# S -> .o (kernel/arch/x86_64/*.S) - GNU assembler
%.o: %.S
	$(KERNEL_CC) $(KERNEL_CFLAGS) -c $< -o $@

$(KERNEL_BUILD_FLAGS_STAMP): FORCE
	@mkdir -p $(dir $@)
	@tmp="$@.tmp"; \
	printf '%s\n' \
		'KERNEL_CC=$(KERNEL_CC)' \
		'KERNEL_CFLAGS=$(KERNEL_CFLAGS)' \
		'KERNEL_CFLAGS_GDT=$(KERNEL_CFLAGS_GDT)' \
		'KERNEL_ASMFLAGS=$(KERNEL_ASMFLAGS)' \
		'KERNEL_LDFLAGS=$(KERNEL_LDFLAGS)' \
		'KERNEL_LINK_EXTRA_FLAGS=$(KERNEL_LINK_EXTRA_FLAGS)' \
		'USER_MINIMAL_EFFECTIVE_MODE=$(USER_MINIMAL_EFFECTIVE_MODE)' \
		'AYKEN_VALIDATION=$(AYKEN_VALIDATION)' \
		'AYKEN_CR3_PCID=$(AYKEN_CR3_PCID)' \
		'AYKEN_RING3_FETCH_PROBE=$(AYKEN_RING3_FETCH_PROBE)' \
		'AYKEN_RING3_SECOND_CANONICAL_PROBE=$(AYKEN_RING3_SECOND_CANONICAL_PROBE)' \
		'AYKEN_RING3_FRESH_FRAME_PROBE=$(AYKEN_RING3_FRESH_FRAME_PROBE)' \
