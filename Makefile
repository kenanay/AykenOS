		'AYKEN_RING3_POST_CR3_TEXT_PROBE=$(AYKEN_RING3_POST_CR3_TEXT_PROBE)' \
		'AYKEN_RING3_MASK_IRQ0_FIRST_ENTRY=$(AYKEN_RING3_MASK_IRQ0_FIRST_ENTRY)' \
		'AYKEN_SHARE_KERNEL_UPPER_HALF=$(AYKEN_SHARE_KERNEL_UPPER_HALF)' \
