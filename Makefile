# Preservation Tests (scheduler-primary-regression-rca Task 2)
# Purpose: Verify preservation properties before optimization
# Expected: All tests PASS on unfixed code (baseline behavior)
ci-gate-preservation-tests: ci-evidence-dir
	@echo "== CI GATE PRESERVATION TESTS =="
	@echo "run_id: $(RUN_ID)"
	@echo "spec: scheduler-primary-regression-rca"
	@echo "task: 2 - Preservation property tests"
	@mkdir -p "$(EVIDENCE_RUN_DIR)/preservation-tests"
	@echo
	@echo ">> Test 1: Boundary Init Idempotency"
	@bash scripts/qemu-second-syscall-proof-harness.sh
	@python3 scripts/ci/test_boundary_init_idempotency.py out/second-syscall-evidence/debugcon.log \
		| tee "$(EVIDENCE_RUN_DIR)/preservation-tests/test1_idempotency.log"
	@if ! grep -q "✅ PASS" "$(EVIDENCE_RUN_DIR)/preservation-tests/test1_idempotency.log"; then \
		echo "❌ FAIL: Boundary init idempotency test failed"; \
		exit 1; \
	fi
	@echo
	@echo ">> Test 2: Anchored Sequence Detection"
	@python3 scripts/ci/test_anchored_sequence.py out/second-syscall-evidence/debugcon.log \
		| tee "$(EVIDENCE_RUN_DIR)/preservation-tests/test2_anchored_sequence.log"
	@if ! grep -q "✅ PASS" "$(EVIDENCE_RUN_DIR)/preservation-tests/test2_anchored_sequence.log"; then \
		echo "❌ FAIL: Anchored sequence test failed"; \
		exit 1; \
	fi
	@echo
	@echo ">> Test 3: Skip Path Performance"
	@python3 scripts/ci/test_skip_path_performance.py out/second-syscall-evidence/debugcon.log \
		| tee "$(EVIDENCE_RUN_DIR)/preservation-tests/test3_skip_path_performance.log"
	@if ! grep -q "✅ PASS" "$(EVIDENCE_RUN_DIR)/preservation-tests/test3_skip_path_performance.log"; then \
		echo "❌ FAIL: Skip path performance test failed"; \
		exit 1; \
	fi
	@echo
	@echo ">> Test 4: Diagnostic Flags Verification"
	@bash scripts/ci/verify_diagnostic_flags.sh \
		| tee "$(EVIDENCE_RUN_DIR)/preservation-tests/test4_diagnostic_flags.log"
