# Phase-17 Execution Slot Build

CC = gcc
CFLAGS = -Wall -Wextra -std=c11 -I../include

SRCS = execution_slot.c execution_slot_test.c
OBJS = $(SRCS:.c=.o)
TARGET = execution_slot_test

.PHONY: all clean test

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $^

%.o: %.c
	$(CC) $(CFLAGS) -c $<

test: $(TARGET)
	@echo "Running Phase-17 execution slot tests..."
	@./$(TARGET)

clean:
	rm -f $(OBJS) $(TARGET)
